{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Beton Dashboard",
  "version": "1.0.0",
  "identifier": "com.smartbeton.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Smart Beton Dashboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Smart Beton",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}